# Copy to deploy/production.env; never commit real credentials.
APP_ENV=production
SERVE_FRONTEND=true
# Replace with your HTTPS origin; no trailing path, query or fragment.
CUSTOMER_PUBLIC_URL=https://support.example.com
# Keep this trio together for backup/restore. Paths resolve from the project root.
DATABASE_URL=sqlite:///./data/production/customer_support.db
QDRANT_PATH=data/production/vectors
KNOWLEDGE_PATH=data/production/knowledge_base
VECTOR_STORE=qdrant
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b
EMBEDDING_MODEL=embeddinggemma:300m
RAG_MIN_SCORE=0.35
# Enable only after live bot acceptance; never run two workers with the same token.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Optional until a sending mailbox is configured. TLS required.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Behind a proxy that forwards /api (Vercel in front of Railway, see docs/DEPLOY_VERCEL_RAILWAY.md):
# the same long random value as the proxy's ORIGIN_SECRET. Leave empty for the one-machine Caddy setup.
ORIGIN_SECRET=
# How long Ollama keeps the model loaded after a request (e.g. 5m, 30m). Longer: fewer slow reloads, more RAM.
LLM_KEEP_ALIVE=5m
