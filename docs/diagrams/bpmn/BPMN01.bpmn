<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="BPMN01_Definitions" targetNamespace="https://dacn-rag.local/week04" exporter="DACN RAG Week04" exporterVersion="1">
  <bpmn:error id="Error_Service" name="Lỗi dịch vụ" errorCode="service_error" />
  <bpmn:process id="Process" name="Tiếp nhận hỏi chính sách và chuyển giao" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane_app" name="Ứng dụng FastAPI">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>duplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_invalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_duplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>queue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_queue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>keep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>error_notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>guard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>drop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_stale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_rag" name="Ollama và Qdrant local">
        <bpmn:flowNodeRef>call_rag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rag_error</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Nhận yêu cầu">
      <bpmn:outgoing>F_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_MessageEvent" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="validate" name="Kiểm tra phiên và dữ liệu đầu vào">
      <bpmn:incoming>F_1</bpmn:incoming>
      <bpmn:outgoing>F_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="valid" name="Hợp lệ?" default="F_4">
      <bpmn:incoming>F_2</bpmn:incoming>
      <bpmn:outgoing>F_3</bpmn:outgoing>
      <bpmn:outgoing>F_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="save" name="Lưu tin khách; kiểm tra UUID">
      <bpmn:incoming>F_3</bpmn:incoming>
      <bpmn:outgoing>F_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="duplicate" name="Tin trùng?" default="F_9">
      <bpmn:incoming>F_6</bpmn:incoming>
      <bpmn:outgoing>F_7</bpmn:outgoing>
      <bpmn:outgoing>F_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="route" name="Trạng thái và yêu cầu?" default="F_15">
      <bpmn:incoming>F_9</bpmn:incoming>
      <bpmn:outgoing>F_10</bpmn:outgoing>
      <bpmn:outgoing>F_11</bpmn:outgoing>
      <bpmn:outgoing>F_13</bpmn:outgoing>
      <bpmn:outgoing>F_14</bpmn:outgoing>
      <bpmn:outgoing>F_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="reject" name="Báo lỗi; giữ bản nháp tại UI">
      <bpmn:incoming>F_4</bpmn:incoming>
      <bpmn:incoming>F_15</bpmn:incoming>
      <bpmn:outgoing>F_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_invalid" name="Yêu cầu bị chặn">
      <bpmn:incoming>F_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="reuse" name="Trả kết quả đã lưu; không gọi lại AI">
      <bpmn:incoming>F_7</bpmn:incoming>
      <bpmn:outgoing>F_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_duplicate" name="Đã phục hồi">
      <bpmn:incoming>F_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="order" name="Tra đơn theo BPMN02">
      <bpmn:incoming>F_11</bpmn:incoming>
      <bpmn:outgoing>F_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_order" name="Kết thúc lượt tra">
      <bpmn:incoming>F_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="queue" name="Tạo hoặc tái dùng ticket; dừng AI">
      <bpmn:incoming>F_13</bpmn:incoming>
      <bpmn:outgoing>F_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_queue" name="Chờ BPMN03">
      <bpmn:incoming>F_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="keep" name="Chỉ lưu tin; chờ nhân viên xử lý">
      <bpmn:incoming>F_14</bpmn:incoming>
      <bpmn:outgoing>F_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_wait" name="AI không chạy">
      <bpmn:incoming>F_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="call_rag" name="Truy hồi nguồn; chọn và kiểm định">
      <bpmn:incoming>F_10</bpmn:incoming>
      <bpmn:outgoing>F_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="rag_error" name="Lỗi dịch vụ" attachedToRef="call_rag" cancelActivity="true">
      <bpmn:outgoing>F_19</bpmn:outgoing>
      <bpmn:errorEventDefinition id="rag_error_ErrorEvent" errorRef="Error_Service" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="error_notice" name="Báo lỗi dịch vụ; giữ tin khách">
      <bpmn:incoming>F_19</bpmn:incoming>
      <bpmn:outgoing>F_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_error" name="Chưa có đáp án">
      <bpmn:incoming>F_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="guard" name="Trạng thái, tin cuối, nguồn còn đúng?" default="F_21">
      <bpmn:incoming>F_18</bpmn:incoming>
      <bpmn:outgoing>F_21</bpmn:outgoing>
      <bpmn:outgoing>F_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="drop" name="Bỏ kết quả AI cũ">
      <bpmn:incoming>F_21</bpmn:incoming>
      <bpmn:outgoing>F_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_stale" name="Không gửi AI cũ">
      <bpmn:incoming>F_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="answer" name="Trả bằng chứng hoặc từ chối / hỏi rõ">
      <bpmn:incoming>F_23</bpmn:incoming>
      <bpmn:outgoing>F_24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_ok" name="Kết thúc lượt">
      <bpmn:incoming>F_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_1" sourceRef="start" targetRef="validate" name="" />
    <bpmn:sequenceFlow id="F_2" sourceRef="validate" targetRef="valid" name="" />
    <bpmn:sequenceFlow id="F_3" sourceRef="valid" targetRef="save" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_4" sourceRef="valid" targetRef="reject" name="Không" />
    <bpmn:sequenceFlow id="F_5" sourceRef="reject" targetRef="end_invalid" name="" />
    <bpmn:sequenceFlow id="F_6" sourceRef="save" targetRef="duplicate" name="" />
    <bpmn:sequenceFlow id="F_7" sourceRef="duplicate" targetRef="reuse" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_8" sourceRef="reuse" targetRef="end_duplicate" name="" />
    <bpmn:sequenceFlow id="F_9" sourceRef="duplicate" targetRef="route" name="Không" />
    <bpmn:sequenceFlow id="F_10" sourceRef="route" targetRef="call_rag" name="Open; chính sách">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Open; chính sách</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_11" sourceRef="route" targetRef="order" name="Open; tra đơn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Open; tra đơn</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_12" sourceRef="order" targetRef="end_order" name="" />
    <bpmn:sequenceFlow id="F_13" sourceRef="route" targetRef="queue" name="Cần người thật">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Cần người thật</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_14" sourceRef="route" targetRef="keep" name="Chờ / assigned">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Chờ / assigned</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_15" sourceRef="route" targetRef="reject" name="Closed" />
    <bpmn:sequenceFlow id="F_16" sourceRef="queue" targetRef="end_queue" name="" />
    <bpmn:sequenceFlow id="F_17" sourceRef="keep" targetRef="end_wait" name="" />
    <bpmn:sequenceFlow id="F_18" sourceRef="call_rag" targetRef="guard" name="" />
    <bpmn:sequenceFlow id="F_19" sourceRef="rag_error" targetRef="error_notice" name="" />
    <bpmn:sequenceFlow id="F_20" sourceRef="error_notice" targetRef="end_error" name="" />
    <bpmn:sequenceFlow id="F_21" sourceRef="guard" targetRef="drop" name="Không" />
    <bpmn:sequenceFlow id="F_22" sourceRef="drop" targetRef="end_stale" name="" />
    <bpmn:sequenceFlow id="F_23" sourceRef="guard" targetRef="answer" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_24" sourceRef="answer" targetRef="end_ok" name="" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Store" name="Cửa hàng giả lập" processRef="Process" />
    <bpmn:participant id="customer" name="Khách hàng" />
    <bpmn:messageFlow id="M_1" sourceRef="customer" targetRef="start" name="Tin khách" />
    <bpmn:messageFlow id="M_2" sourceRef="answer" targetRef="customer" name="Phản hồi qua kênh" />
  </bpmn:collaboration>
