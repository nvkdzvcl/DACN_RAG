<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="BPMN04_Definitions" targetNamespace="https://dacn-rag.local/week04" exporter="DACN RAG Week04" exporterVersion="1">
  <bpmn:error id="Error_Service" name="Lỗi dịch vụ" errorCode="service_error" />
  <bpmn:process id="Process" name="Quản lý và lập chỉ mục tri thức" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane_admin" name="Quản trị viên">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reindex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ready</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_app" name="Ứng dụng FastAPI">
        <bpmn:flowNodeRef>validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_invalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>extract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>parse_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>content</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>delete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_deleted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_rag" name="Ollama và Qdrant local">
        <bpmn:flowNodeRef>index</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>index_error</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Có tài liệu">
      <bpmn:outgoing>F_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="upload" name="Chọn tài liệu và yêu cầu tải lên">
      <bpmn:incoming>F_1</bpmn:incoming>
      <bpmn:outgoing>F_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="validate" name="Kiểm tra loại, 10 MB và hash">
      <bpmn:incoming>F_2</bpmn:incoming>
      <bpmn:outgoing>F_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="valid" name="File hợp lệ?" default="F_5">
      <bpmn:incoming>F_3</bpmn:incoming>
      <bpmn:outgoing>F_4</bpmn:outgoing>
      <bpmn:outgoing>F_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="reject" name="Từ chối; thông báo lỗi hoặc trùng file">
      <bpmn:incoming>F_5</bpmn:incoming>
      <bpmn:outgoing>F_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_invalid" name="Chưa lập chỉ mục">
      <bpmn:incoming>F_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="extract" name="Lưu nguồn; đọc và chia đoạn có vị trí">
      <bpmn:incoming>F_4</bpmn:incoming>
      <bpmn:incoming>F_17</bpmn:incoming>
      <bpmn:outgoing>F_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="parse_error" name="Lỗi đọc file" attachedToRef="extract" cancelActivity="true">
      <bpmn:outgoing>F_8</bpmn:outgoing>
      <bpmn:errorEventDefinition id="parse_error_ErrorEvent" errorRef="Error_Service" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="content" name="Có nội dung đọc được?" default="F_10">
      <bpmn:incoming>F_7</bpmn:incoming>
      <bpmn:outgoing>F_9</bpmn:outgoing>
      <bpmn:outgoing>F_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="index" name="Tạo embedding; ghi vector mới">
      <bpmn:incoming>F_9</bpmn:incoming>
      <bpmn:outgoing>F_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="index_error" name="Lỗi chỉ mục" attachedToRef="index" cancelActivity="true">
      <bpmn:outgoing>F_12</bpmn:outgoing>
      <bpmn:errorEventDefinition id="index_error_ErrorEvent" errorRef="Error_Service" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="error" name="Đánh dấu lỗi; cho phép lập lại">
      <bpmn:incoming>F_8</bpmn:incoming>
      <bpmn:incoming>F_10</bpmn:incoming>
      <bpmn:incoming>F_12</bpmn:incoming>
      <bpmn:outgoing>F_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_error" name="Chưa sẵn sàng">
      <bpmn:incoming>F_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ready" name="Đánh dấu sẵn sàng; cho phép truy hồi">
      <bpmn:incoming>F_13</bpmn:incoming>
      <bpmn:outgoing>F_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="action" name="Thao tác tiếp?" default="F_15">
      <bpmn:incoming>F_14</bpmn:incoming>
      <bpmn:outgoing>F_15</bpmn:outgoing>
      <bpmn:outgoing>F_16</bpmn:outgoing>
      <bpmn:outgoing>F_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="reindex" name="Lập chỉ mục lại phiên bản mới">
      <bpmn:incoming>F_16</bpmn:incoming>
      <bpmn:outgoing>F_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="delete" name="Ngừng truy hồi rồi dọn file / vector">
      <bpmn:incoming>F_18</bpmn:incoming>
      <bpmn:outgoing>F_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_deleted" name="Đã ngừng dùng nguồn">
      <bpmn:incoming>F_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_ready" name="Giữ nguồn sẵn sàng">
      <bpmn:incoming>F_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_1" sourceRef="start" targetRef="upload" name="" />
    <bpmn:sequenceFlow id="F_2" sourceRef="upload" targetRef="validate" name="" />
    <bpmn:sequenceFlow id="F_3" sourceRef="validate" targetRef="valid" name="" />
    <bpmn:sequenceFlow id="F_4" sourceRef="valid" targetRef="extract" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_5" sourceRef="valid" targetRef="reject" name="Không" />
    <bpmn:sequenceFlow id="F_6" sourceRef="reject" targetRef="end_invalid" name="" />
    <bpmn:sequenceFlow id="F_7" sourceRef="extract" targetRef="content" name="" />
    <bpmn:sequenceFlow id="F_8" sourceRef="parse_error" targetRef="error" name="" />
    <bpmn:sequenceFlow id="F_9" sourceRef="content" targetRef="index" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_10" sourceRef="content" targetRef="error" name="Không; scan chưa OCR" />
    <bpmn:sequenceFlow id="F_11" sourceRef="error" targetRef="end_error" name="" />
    <bpmn:sequenceFlow id="F_12" sourceRef="index_error" targetRef="error" name="" />
    <bpmn:sequenceFlow id="F_13" sourceRef="index" targetRef="ready" name="" />
    <bpmn:sequenceFlow id="F_14" sourceRef="ready" targetRef="action" name="" />
    <bpmn:sequenceFlow id="F_15" sourceRef="action" targetRef="end_ready" name="Giữ" />
    <bpmn:sequenceFlow id="F_16" sourceRef="action" targetRef="reindex" name="Lập lại">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Lập lại</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_17" sourceRef="reindex" targetRef="extract" name="" />
    <bpmn:sequenceFlow id="F_18" sourceRef="action" targetRef="delete" name="Xóa">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Xóa</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_19" sourceRef="delete" targetRef="end_deleted" name="" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Store" name="Cửa hàng giả lập" processRef="Process" />
  </bpmn:collaboration>
