<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="BPMN03_Definitions" targetNamespace="https://dacn-rag.local/week04" exporter="DACN RAG Week04" exporterVersion="1">
  <bpmn:error id="Error_Service" name="Lỗi dịch vụ" errorCode="service_error" />
  <bpmn:process id="Process" name="Nhân viên xử lý ticket và giao phản hồi" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane_staff" name="Nhân viên phụ trách">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>compose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>finish</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_app" name="Ứng dụng FastAPI và worker">
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assigned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_conflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>channel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>web</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tg_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>skip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>current</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Có ticket chờ">
      <bpmn:outgoing>F_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="accept" name="Đọc hàng chờ; yêu cầu tiếp nhận">
      <bpmn:incoming>F_1</bpmn:incoming>
      <bpmn:outgoing>F_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="assign" name="Gán có điều kiện; kiểm tra phụ trách">
      <bpmn:incoming>F_2</bpmn:incoming>
      <bpmn:outgoing>F_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="assigned" name="Nhận thành công?" default="F_5">
      <bpmn:incoming>F_3</bpmn:incoming>
      <bpmn:outgoing>F_4</bpmn:outgoing>
      <bpmn:outgoing>F_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="conflict" name="Báo tranh chấp; yêu cầu tải lại">
      <bpmn:incoming>F_5</bpmn:incoming>
      <bpmn:outgoing>F_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_conflict" name="Người khác nhận">
      <bpmn:incoming>F_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="compose" name="Đọc tin; soạn phản hồi / đọc lại">
      <bpmn:incoming>F_4</bpmn:incoming>
      <bpmn:incoming>F_19</bpmn:incoming>
      <bpmn:incoming>F_25</bpmn:incoming>
      <bpmn:outgoing>F_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="save" name="Lưu phản hồi staff với UUID">
      <bpmn:incoming>F_7</bpmn:incoming>
      <bpmn:outgoing>F_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="channel" name="Kênh giao tin?" default="F_11">
      <bpmn:incoming>F_8</bpmn:incoming>
      <bpmn:outgoing>F_9</bpmn:outgoing>
      <bpmn:outgoing>F_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="web" name="Website: cho khách đọc bằng polling">
      <bpmn:incoming>F_9</bpmn:incoming>
      <bpmn:outgoing>F_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="tg" name="Telegram: hàng gửi và sendMessage">
      <bpmn:incoming>F_11</bpmn:incoming>
      <bpmn:incoming>F_16</bpmn:incoming>
      <bpmn:outgoing>F_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="tg_error" name="Lỗi giao tin" attachedToRef="tg" cancelActivity="true">
      <bpmn:outgoing>F_13</bpmn:outgoing>
      <bpmn:errorEventDefinition id="tg_error_ErrorEvent" errorRef="Error_Service" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="failed" name="Ghi lỗi / chưa rõ; chặn tin cùng peer">
      <bpmn:incoming>F_13</bpmn:incoming>
      <bpmn:outgoing>F_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="decision" name="Retry hoặc skip; uncertain: xác nhận">
      <bpmn:incoming>F_14</bpmn:incoming>
      <bpmn:outgoing>F_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="retry" name="Gửi lại?" default="F_17">
      <bpmn:incoming>F_15</bpmn:incoming>
      <bpmn:outgoing>F_16</bpmn:outgoing>
      <bpmn:outgoing>F_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="skip" name="Giữ lịch sử; đánh dấu skipped">
      <bpmn:incoming>F_17</bpmn:incoming>
      <bpmn:outgoing>F_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="more" name="Hỗ trợ tiếp?" default="F_20">
      <bpmn:incoming>F_10</bpmn:incoming>
      <bpmn:incoming>F_12</bpmn:incoming>
      <bpmn:incoming>F_18</bpmn:incoming>
      <bpmn:outgoing>F_19</bpmn:outgoing>
      <bpmn:outgoing>F_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="finish" name="Resolved / closed; ghi chú và tin cuối">
      <bpmn:incoming>F_20</bpmn:incoming>
      <bpmn:outgoing>F_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="check" name="Kiểm tra ticket, người và tin cuối">
      <bpmn:incoming>F_21</bpmn:incoming>
      <bpmn:outgoing>F_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="current" name="Đủ điều kiện?" default="F_25">
      <bpmn:incoming>F_22</bpmn:incoming>
      <bpmn:outgoing>F_23</bpmn:outgoing>
      <bpmn:outgoing>F_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="commit" name="Chốt ticket và SLA; lưu người, thời điểm">
      <bpmn:incoming>F_23</bpmn:incoming>
      <bpmn:outgoing>F_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_ok" name="Kết thúc lượt hỗ trợ">
      <bpmn:incoming>F_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_1" sourceRef="start" targetRef="accept" name="" />
    <bpmn:sequenceFlow id="F_2" sourceRef="accept" targetRef="assign" name="" />
    <bpmn:sequenceFlow id="F_3" sourceRef="assign" targetRef="assigned" name="" />
    <bpmn:sequenceFlow id="F_4" sourceRef="assigned" targetRef="compose" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_5" sourceRef="assigned" targetRef="conflict" name="Không" />
    <bpmn:sequenceFlow id="F_6" sourceRef="conflict" targetRef="end_conflict" name="" />
    <bpmn:sequenceFlow id="F_7" sourceRef="compose" targetRef="save" name="" />
    <bpmn:sequenceFlow id="F_8" sourceRef="save" targetRef="channel" name="" />
    <bpmn:sequenceFlow id="F_9" sourceRef="channel" targetRef="web" name="Website">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Website</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_10" sourceRef="web" targetRef="more" name="" />
    <bpmn:sequenceFlow id="F_11" sourceRef="channel" targetRef="tg" name="Telegram" />
    <bpmn:sequenceFlow id="F_12" sourceRef="tg" targetRef="more" name="Đã gửi" />
    <bpmn:sequenceFlow id="F_13" sourceRef="tg_error" targetRef="failed" name="" />
    <bpmn:sequenceFlow id="F_14" sourceRef="failed" targetRef="decision" name="" />
    <bpmn:sequenceFlow id="F_15" sourceRef="decision" targetRef="retry" name="" />
    <bpmn:sequenceFlow id="F_16" sourceRef="retry" targetRef="tg" name="Có, xác nhận khi cần">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Có, xác nhận khi cần</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_17" sourceRef="retry" targetRef="skip" name="Không" />
    <bpmn:sequenceFlow id="F_18" sourceRef="skip" targetRef="more" name="" />
    <bpmn:sequenceFlow id="F_19" sourceRef="more" targetRef="compose" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_20" sourceRef="more" targetRef="finish" name="Hoàn tất" />
    <bpmn:sequenceFlow id="F_21" sourceRef="finish" targetRef="check" name="" />
    <bpmn:sequenceFlow id="F_22" sourceRef="check" targetRef="current" name="" />
    <bpmn:sequenceFlow id="F_23" sourceRef="current" targetRef="commit" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_24" sourceRef="commit" targetRef="end_ok" name="" />
    <bpmn:sequenceFlow id="F_25" sourceRef="current" targetRef="compose" name="Xung đột; đọc lại" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Store" name="Cửa hàng giả lập" processRef="Process" />
    <bpmn:participant id="customer" name="Khách hàng" />
    <bpmn:participant id="telegram" name="Telegram Bot API" />
    <bpmn:messageFlow id="M_1" sourceRef="tg" targetRef="telegram" name="sendMessage" />
    <bpmn:messageFlow id="M_2" sourceRef="telegram" targetRef="tg" name="Kết quả gửi" />
    <bpmn:messageFlow id="M_3" sourceRef="web" targetRef="customer" name="Phản hồi Website" />
  </bpmn:collaboration>
