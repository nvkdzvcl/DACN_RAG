<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="BPMN02_Definitions" targetNamespace="https://dacn-rag.local/week04" exporter="DACN RAG Week04" exporterVersion="1">
  <bpmn:error id="Error_Service" name="Lỗi dịch vụ" errorCode="service_error" />
  <bpmn:process id="Process" name="Xác minh và tra cứu đơn hàng" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane_app" name="Ứng dụng FastAPI">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>scope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>access</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>code</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lookup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>guard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>handoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_queue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_admin" name="Quản trị viên">
        <bpmn:flowNodeRef>verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>verified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Yêu cầu tra đơn">
      <bpmn:outgoing>F_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="start_MessageEvent" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="scope" name="Widget và chỉ yêu cầu tra cứu?" default="F_3">
      <bpmn:incoming>F_1</bpmn:incoming>
      <bpmn:outgoing>F_2</bpmn:outgoing>
      <bpmn:outgoing>F_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="access" name="Đã có quyền còn hiệu lực?" default="F_5">
      <bpmn:incoming>F_2</bpmn:incoming>
      <bpmn:outgoing>F_4</bpmn:outgoing>
      <bpmn:outgoing>F_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="verify" name="Xác minh qua kênh liên hệ tin cậy">
      <bpmn:incoming>F_5</bpmn:incoming>
      <bpmn:outgoing>F_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="verified" name="Xác minh đạt?" default="F_8">
      <bpmn:incoming>F_6</bpmn:incoming>
      <bpmn:outgoing>F_7</bpmn:outgoing>
      <bpmn:outgoing>F_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="issue" name="Cấp mã một đơn; hạn 15 phút">
      <bpmn:incoming>F_7</bpmn:incoming>
      <bpmn:outgoing>F_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="deliver" name="Giao mã qua kênh đã xác minh">
      <bpmn:incoming>F_9</bpmn:incoming>
      <bpmn:outgoing>F_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="receive" name="Nhận mã tại biểu mẫu riêng">
      <bpmn:incoming>F_10</bpmn:incoming>
      <bpmn:outgoing>F_11</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="code" name="Mã và quyền hợp lệ?" default="F_13">
      <bpmn:incoming>F_11</bpmn:incoming>
      <bpmn:outgoing>F_12</bpmn:outgoing>
      <bpmn:outgoing>F_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="lookup" name="Tra trạng thái và vận đơn được phép">
      <bpmn:incoming>F_4</bpmn:incoming>
      <bpmn:incoming>F_12</bpmn:incoming>
      <bpmn:outgoing>F_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="guard" name="Quyền và chủ đơn còn đúng?" default="F_17">
      <bpmn:incoming>F_14</bpmn:incoming>
      <bpmn:outgoing>F_15</bpmn:outgoing>
      <bpmn:outgoing>F_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="reply" name="Chỉ trả trạng thái và vận đơn">
      <bpmn:incoming>F_15</bpmn:incoming>
      <bpmn:outgoing>F_16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_ok" name="Kết thúc lượt">
      <bpmn:incoming>F_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="handoff" name="Handoff; không lộ dữ liệu đơn">
      <bpmn:incoming>F_3</bpmn:incoming>
      <bpmn:incoming>F_8</bpmn:incoming>
      <bpmn:incoming>F_13</bpmn:incoming>
      <bpmn:incoming>F_17</bpmn:incoming>
      <bpmn:outgoing>F_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_queue" name="Chờ xử lý">
      <bpmn:incoming>F_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_1" sourceRef="start" targetRef="scope" name="" />
    <bpmn:sequenceFlow id="F_2" sourceRef="scope" targetRef="access" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_3" sourceRef="scope" targetRef="handoff" name="Telegram / hủy / đổi trả" />
    <bpmn:sequenceFlow id="F_4" sourceRef="access" targetRef="lookup" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_5" sourceRef="access" targetRef="verify" name="Chưa" />
    <bpmn:sequenceFlow id="F_6" sourceRef="verify" targetRef="verified" name="" />
    <bpmn:sequenceFlow id="F_7" sourceRef="verified" targetRef="issue" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_8" sourceRef="verified" targetRef="handoff" name="Không" />
    <bpmn:sequenceFlow id="F_9" sourceRef="issue" targetRef="deliver" name="" />
    <bpmn:sequenceFlow id="F_10" sourceRef="deliver" targetRef="receive" name="" />
    <bpmn:sequenceFlow id="F_11" sourceRef="receive" targetRef="code" name="" />
    <bpmn:sequenceFlow id="F_12" sourceRef="code" targetRef="lookup" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_13" sourceRef="code" targetRef="handoff" name="Sai / hết hạn" />
    <bpmn:sequenceFlow id="F_14" sourceRef="lookup" targetRef="guard" name="" />
    <bpmn:sequenceFlow id="F_15" sourceRef="guard" targetRef="reply" name="Có">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="text/plain">Có</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_16" sourceRef="reply" targetRef="end_ok" name="" />
    <bpmn:sequenceFlow id="F_17" sourceRef="guard" targetRef="handoff" name="Thu hồi / hết hạn" />
    <bpmn:sequenceFlow id="F_18" sourceRef="handoff" targetRef="end_queue" name="" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Store" name="Cửa hàng giả lập" processRef="Process" />
    <bpmn:participant id="customer" name="Khách hàng widget" />
    <bpmn:messageFlow id="M_1" sourceRef="customer" targetRef="start" name="Yêu cầu" />
    <bpmn:messageFlow id="M_2" sourceRef="deliver" targetRef="customer" name="Mã qua kênh tin cậy" />
    <bpmn:messageFlow id="M_3" sourceRef="customer" targetRef="receive" name="Nhập mã tại biểu mẫu" />
    <bpmn:messageFlow id="M_4" sourceRef="reply" targetRef="customer" name="Kết quả được phép" />
  </bpmn:collaboration>
