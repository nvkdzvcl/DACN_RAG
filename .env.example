APP_ENV=development
SERVE_FRONTEND=false
DATABASE_URL=sqlite:///./data/customer_support.db
VECTOR_STORE=qdrant
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b
EMBEDDING_MODEL=embeddinggemma:300m
QDRANT_PATH=data/vectors
KNOWLEDGE_PATH=data/knowledge_base
RAG_MIN_SCORE=0.35
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Enable only a dedicated test bot with private chats; one API worker, no webhook.
# Set APP_ENV=production behind HTTPS to require Secure session cookies.
# Load explicitly: python -m uvicorn app.main:app --reload --env-file .env

# Customer verification and password recovery (SMTP STARTTLS or SSL only).
# Origin of the customer UI; HTTPS required outside local development.
CUSTOMER_PUBLIC_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Put real credentials in .env only; never commit them. No SMTP credentials in the browser.
